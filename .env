# Maison Velours - environment settings

# Port the server listens on
PORT=3000

# Telegram bot token from @BotFather (required for order notifications)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Chat IDs that receive order alerts, comma-separated (required)
# Example: TELEGRAM_CHAT_IDS=123456789,987654321
TELEGRAM_CHAT_IDS=your-chat-id-here

# Allowed site origins for orders, comma-separated, no trailing slash.
# Must match your site exactly, including https://. Leave empty to disable the check.
# Example: ALLOWED_ORIGINS=https://yourstore.com,https://www.yourstore.com
ALLOWED_ORIGINS=

# Time zone used for the startup notification time (12-hour format)
TIMEZONE=Africa/Lagos
