# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs to notify on new orders
TELEGRAM_CHAT_IDS=

# Comma-separated list of allowed origins for CORS/order-endpoint checks
# Leave empty during local dev to disable origin checking
ALLOWED_ORIGINS=

# Port the server listens on (optional, defaults to 3000)
PORT=3000
